{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "biorise-r4do.vercel.app"
        }
      ],
      "destination": "https://biorise-clinic.ru/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/yandex_ff70510bc15914e1.html",
      "destination": "/yandex_ff70510bc15914e1/"
    }
  ],
  "headers": [
    {
      "source": "/yandex_ff70510bc15914e1.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=UTF-8"
        }
      ]
    }
  ]
}
